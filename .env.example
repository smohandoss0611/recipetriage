# Local development only. Replace before deployment; never commit .env.
POSTGRES_USER=recipetriage
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=recipetriage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Optional hosted inference. Leave key empty until configured; never commit .env.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
FIREWORKS_SYNTHETIC_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
# Recipe extraction, automatic library triage and side-by-side comparison.
FIREWORKS_RECIPE_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b

# Managed SFT: choose a currently tunable model and a compatible deployment shape.
# Leave account ID empty only when the key can access exactly one account.
FIREWORKS_ACCOUNT_ID=
FIREWORKS_SFT_MODEL=
FIREWORKS_SFT_DEPLOYMENT_SHAPE=

# Optional dashboard: set URI to http://mlflow:5000 and start the tracking profile.
# Blank uses local SQLite under TRAINING_RUNS_DIR, without a dashboard server.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=RecipeTriage-fixed-benchmark
MLFLOW_PORT=5050

# Blank applies the strict defaults documented in MODEL_REGISTRY.md.
# JSON override is operator configuration, never a UI-supplied promotion score.
MODEL_GATE_JSON=
